# Copia este archivo como .env y ajusta los valores para tu entorno.
# En AWS configura estas variables en el entorno del servicio (nunca las subas al repositorio).

DEBUG=False

# Genera una clave nueva, por ejemplo con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Dominios desde los que se accederá al sistema.
ALLOWED_HOSTS=tu-dominio.com,www.tu-dominio.com,localhost,127.0.0.1

# Obligatorio si usas HTTPS con un dominio propio detrás de un proxy/balanceador.
CSRF_TRUSTED_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# Dominio público que se graba dentro del QR de las etiquetas.
SITE_URL=https://tu-dominio.com

# PostgreSQL en AWS RDS. Si se omite, se usa SQLite local.
# DATABASE_URL=postgres://usuario:clave@host:5432/nombre_db

# Seguridad HTTPS. Déjalo en True si AWS termina el SSL en el balanceador.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
